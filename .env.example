# Gemini API key — required only for auto-generating scripts from an idea.
GEMINI_API_KEY=

# Gemini model used for script writing.
GEMINI_MODEL=gemini-2.5-flash

# HTTP server settings (optional).
PORT=8283
HOST=0.0.0.0

# Session cookie signing secret — REQUIRED in production. If empty and
# NODE_ENV=production the app refuses to start. In development a random
# secret is generated per boot (sessions reset on restart).
SESSIONS_SECRET=

# SQLite database file location (optional).
DB_PATH=./data/app.db

# Set to 1 when serving over HTTPS so session cookies are marked Secure.
COOKIE_SECURE=0

# Number of reverse-proxy hops to trust (Nginx/Cloudflare). Set to 1 when
# behind a single proxy so Secure cookies and IP-based rate limits work.
TRUST_PROXY=0

# Overall per-job time limit in milliseconds (default 600000 = 10 min).
# A job that exceeds this is killed and marked failed with errorCode=job_timeout.
JOB_TIMEOUT_MS=600000

# Output retention in days for the free plan (default 7). Completed projects
# (and any orphan output files) older than this are deleted automatically.
OUTPUT_RETENTION_DAYS=7

# Maximum accepted script length in characters (default 5000).
MAX_SCRIPT_CHARS=5000

# Free-plan monthly video quota (default 10). Submissions beyond it are
# rejected with HTTP 429 and an Arabic message until the next month.
FREE_MONTHLY_VIDEO_LIMIT=10

# Premium (paid) monthly video quota (default 200).
PREMIUM_MONTHLY_VIDEO_LIMIT=200

# PayPal billing (sandbox | live | mock). "mock" skips PayPal entirely so the
# checkout/webhook flow works without an account (used by tests).
# In sandbox/live you need: a REST app (client id/secret), a billing plan
# (created in the PayPal dashboard, its id here), and a webhook with its
# signature id. PAYPAL_BASE_URL is the public URL PayPal redirects buyers to
# after approving (e.g. https://app.example.com).
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PLAN_ID=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=

# Comma-separated admin emails allowed to call the internal /api/admin/*
# endpoints (job review, queue, overview counters). Empty = no admin access.
ADMIN_EMAILS=

# SQLite online backup settings (defaults: data/backups, keep 5, run at boot
# then every 24h).
BACKUP_DIR=./data/backups
BACKUP_KEEP=5
BACKUP_INTERVAL_MS=86400000
