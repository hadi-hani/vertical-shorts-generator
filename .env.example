# Gemini API key — required only for auto-generating scripts from an idea.
GEMINI_API_KEY=

# Gemini model used for script writing.
GEMINI_MODEL=gemini-2.5-flash

# Pexels API key — required only for footage backgrounds (video/image).
# Get one at https://www.pexels.com/api/
PEXELS_API_KEY=

# HTTP server settings (optional).
PORT=8283
HOST=0.0.0.0
